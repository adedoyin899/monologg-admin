{
  "name": "@monologg/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node --import tsx --env-file=.env --watch src/index.ts",
    "start": "prisma migrate deploy && tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "verify:db": "node scripts/verify-supabase-connection.mjs",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "set-test-user": "tsx scripts/set-test-user.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "@monologg/types": "workspace:*",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.69.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.2",
    "fastify": "^5.4.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^3.2.7",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
